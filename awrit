#!/usr/bin/env bash

set -euo pipefail

# readlink -f but works on macOS too
resolve_link() {
  local target="$1"
  while [ -L "$target" ]; do
    target="$(readlink "$target")"
    if [[ "$target" != /* ]]; then
      target="$(dirname "$1")/$target"
    fi
  done
  echo "$target"
}

BASE_DIR=$(cd -- "$(dirname -- "$(resolve_link "${BASH_SOURCE:-$0}")")" &>/dev/null && pwd)

# Kitty graphics and progressive keyboard sequences are terminal protocols;
# tmux does not transparently forward the traffic Awrit emits. On macOS,
# preserve the tmux launch as a lazy typed-window action but run the browser in
# a direct Ghostty surface. Removing TMUX/TMUX_PANE prevents the child launcher
# from handing off recursively.
if [[ -n "${TMUX:-}" && "$(uname -s)" == "Darwin" ]]; then
  open_bin="${AWRIT_OPEN_BIN:-/usr/bin/open}"
  env -u TMUX -u TMUX_PANE "$open_bin" -na Ghostty.app --args \
    "--working-directory=$PWD" \
    "--title=awrit" \
    -e "$BASE_DIR/awrit" "$@"
  exit 0
fi

if [ ! -d "$BASE_DIR/node_modules" ]; then
    "$BASE_DIR/setup.sh"
fi

BUN="$BASE_DIR/.bun/bin/bun"
echo "shim" "$@" > "$BASE_DIR/awrit_error.txt"
exec -a awrit "$BUN" run "$BASE_DIR/src/runner" "$@" 2>"$BASE_DIR/awrit_error.txt"
