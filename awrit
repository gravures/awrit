#!/usr/bin/env bash

set -euo pipefail

# readlink -f but works on macOS too
resolve_link() {
  local target="$1"
  while [ -L "$target" ]; do
    target="$(readlink "$target")"
    if [[ "$target" != /* ]]; then
      target="$(dirname "$1")/$target"
    fi
  done
  echo "$target"
}

BASE_DIR=$(cd -- "$(dirname -- "$(resolve_link "${BASH_SOURCE:-$0}")")" &>/dev/null && pwd)
if [ ! -d "$BASE_DIR/node_modules" ]; then
  echo "awrit: development checkout not installed — run 'mise install'" >&2
  exit 1
fi

# Resolve the project's pinned bun through mise first: `mise which bun` prints the
# executable that mise.toml pins, and `-C "$BASE_DIR"` makes it honor this checkout.
# `.bun/bin/bun` was a setup.sh artifact that no longer exists; `bun` on PATH is
# the fallback for shells where mise is unavailable.
BUN=""
if command -v mise >/dev/null 2>&1; then
  if mise_bun="$(mise -C "$BASE_DIR" which bun 2>/dev/null)" && [ -x "$mise_bun" ]; then
    BUN="$mise_bun"
  fi
fi
if [ -z "$BUN" ] && command -v bun >/dev/null 2>&1; then
  BUN="$(command -v bun)"
fi
if [ -z "$BUN" ]; then
  echo "awrit: bun not found — run 'mise install'" >&2
  exit 1
fi
echo "shim" "$@" >"$BASE_DIR/awrit_error.txt"

restore_tmux_passthrough() {
  local status=$?
  trap - EXIT
  sleep 0.05
  if [[ "$AWRIT_TMUX_PASSTHROUGH_RESTORE_MODE" == "inherit" ]]; then
    tmux set-option -p -u -t "$TMUX_PANE" allow-passthrough >/dev/null 2>&1 || true
  else
    tmux set-option -p -t "$TMUX_PANE" allow-passthrough \
      "$AWRIT_TMUX_PREVIOUS_PASSTHROUGH" >/dev/null 2>&1 || true
  fi
  exit "$status"
}

if [[ -n "${TMUX:-}" ]]; then
  if [[ ! "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]]; then
    echo "awrit: refusing tmux launch with an invalid TMUX_PANE" >&2
    exit 1
  fi
  if ! AWRIT_TMUX_LOCAL_PASSTHROUGH="$(
    tmux show-options -p -v -t "$TMUX_PANE" allow-passthrough 2>/dev/null
  )"; then
    echo "awrit: unable to read pane-local tmux passthrough" >&2
    exit 1
  fi
  if ! AWRIT_TMUX_EFFECTIVE_PASSTHROUGH="$(
    tmux show-options -p -A -v -t "$TMUX_PANE" allow-passthrough 2>/dev/null
  )"; then
    echo "awrit: unable to read effective tmux passthrough" >&2
    exit 1
  fi
  if [[ ! "$AWRIT_TMUX_EFFECTIVE_PASSTHROUGH" =~ ^(on|off|all)$ ]]; then
    echo "awrit: tmux returned an invalid effective passthrough value" >&2
    exit 1
  fi
  if [[ -z "$AWRIT_TMUX_LOCAL_PASSTHROUGH" ]]; then
    AWRIT_TMUX_PASSTHROUGH_RESTORE_MODE=inherit
    AWRIT_TMUX_PREVIOUS_PASSTHROUGH=""
  elif [[ "$AWRIT_TMUX_LOCAL_PASSTHROUGH" =~ ^(on|off|all)$ ]]; then
    AWRIT_TMUX_PASSTHROUGH_RESTORE_MODE=local
    AWRIT_TMUX_PREVIOUS_PASSTHROUGH="$AWRIT_TMUX_LOCAL_PASSTHROUGH"
  else
    echo "awrit: tmux returned an invalid pane-local passthrough value" >&2
    exit 1
  fi
  if ! tmux set-option -p -t "$TMUX_PANE" allow-passthrough all; then
    echo "awrit: unable to enable pane-local tmux passthrough" >&2
    exit 1
  fi
  trap restore_tmux_passthrough EXIT
  "$BUN" run "$BASE_DIR/src/runner" "$@" 2>"$BASE_DIR/awrit_error.txt"
  exit $?
fi

# rename our process: exec -a only sets argv[0]; comm is set in-process
# (src/runner, src/index) because the kernel resets comm on exec and the
# tmux path cannot exec without skipping the passthrough restore trap.
exec -a awrit "$BUN" run "$BASE_DIR/src/runner" "$@" 2>"$BASE_DIR/awrit_error.txt"
