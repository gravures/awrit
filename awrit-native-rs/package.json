{
  "name": "awrit-native-rs",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "BSD-3-Clause",
  "napi": {
    "binaryName": "awrit-native-rs",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "make": "napi build --platform --release && bun scripts/fix-types.js",
    "ci": "napi build --platform --release && bun scripts/fix-types.js",
    "make:debug": "napi build --platform && bun scripts/fix-types.js"
  }
}
